    letter-spacing: 1px;
    margin-bottom: 24px;
  }
  h2 {
    font-family: 'Georgia', serif;
    color: #683846;
    font-size: 16pt;
    margin-top: 24px;
    margin-bottom: 12px;
    border-bottom: 1pt solid #E5D5D8;
    padding-bottom: 4px;
  }
  h3 {
    font-family: 'Georgia', serif;
    color: #B75B70;
    font-size: 13pt;
    margin-top: 16px;
    margin-bottom: 8px;
  }
  p, li {
    font-size: 10.5pt;
    color: #332D2F;
  }
  .meta-box {
    background-color: #F8EDEF;
    border: 1pt solid #E2CBD0;
    border-radius: 6px;
    padding: 12px 18px;
    margin-bottom: 24px;
  }
  .meta-box table {
    width: 100%;
    border-collapse: collapse;
  }
  .meta-box td {
    padding: 4px 8px;
    font-size: 10pt;
  }
  table.data-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    margin-bottom: 20px;
    font-size: 10pt;
  }
  table.data-table th {
    background-color: #683846;
    color: #FFFFFF;
    font-weight: bold;
    text-align: left;
    padding: 10px 12px;
    border: 1pt solid #683846;
  }
  table.data-table td {
    padding: 9px 12px;
    border: 1pt solid #E5D5D8;
    vertical-align: top;
  }
  table.data-table tr:nth-child(even) {
    background-color: #FAF5F6;
  }
