rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Articles collection
    match /articles/{articleId} {
      allow read, write: if true;
    }
    
    // Deleted articles tracking
    match /deleted_articles/{docId} {
      allow read, write: if true;
    }
    
    // Settings collection (site status, homepage, deals, etc.)
    match /settings/{document=**} {
      allow read, write: if true;
    }
  }
}
